# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
venv/
ENV/
env/

# Node dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
frontend/dist/
dist/
build/

# SQLite databases & runtime data
*.db
*.sqlite
*.sqlite3
backend/breast_care_ma.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# IDE & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.ultralytics/
backend/.ultralytics/

# Model weights (large binary files — do not push to GitHub)
backend/weights/*.pth
backend/weights/*.pt
# Keep metrics JSON files (small, human-readable)
!backend/weights/*.json

# CBIS-DDSM DICOM images (163+ GB — never push)
datasets/cbis_ddsm/images/
datasets/cbis_ddsm/images_overflow/

# BUSI dataset images (do not push raw dataset)
datasets/BUSI/

# Training artifacts and overlays
training/audit_overlays/
training/inspection_overlays/
training/__pycache__/

# Keep gitignore placeholder files
!datasets/.gitkeep
!datasets/cbis_ddsm/.gitkeep
